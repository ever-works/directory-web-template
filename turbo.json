{
	"$schema": "https://turbo.build/schema.json",
	"agentGuidance": false,
	"tasks": {
		"build": {
			"dependsOn": [
				"^build"
			],
			"outputs": [
				".next/**",
				"!.next/cache/**",
				"build/**",
				"dist/**"
			],
			"env": [
				"ANALYZE",
				"AUTH_*",
				"COOKIE_SECRET",
				"CRON_SECRET",
				"DATA_REPOSITORY",
				"DATABASE_*",
				"DOCS_HOME_CANONICAL_PATH",
				"DOCS_LOCALES",
				"DOCS_URL",
				"EMAIL_*",
				"GH_*",
				"GITHUB_*",
				"NEXT_PUBLIC_*",
				"PLATFORM_API_*",
				"POLAR_*",
				"POSTHOG_*",
				"RESEND_*",
				"SENTRY_*",
				"STANDALONE_BUILD",
				"SMTP_*",
				"STRIPE_*",
				"TRIGGER_DEV_*",
				"VERCEL_*"
			]
		},
		"build:en": {
			"dependsOn": [
				"^build"
			],
			"outputs": [
				"build/**"
			],
			"env": [
				"DOCS_HOME_CANONICAL_PATH",
				"DOCS_LOCALES",
				"DOCS_URL"
			]
		},
		"lint": {
			"dependsOn": [
				"^build"
			]
		},
		"dev": {
			"cache": false,
			"persistent": true
		},
		"test:e2e": {
			"dependsOn": [
				"build"
			],
			"cache": false
		},
		"test:unit": {
			"cache": false
		},
		"clean": {
			"cache": false
		}
	}
}
